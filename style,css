* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
}

body {
    margin: 0;
    font-family: Arial, sans-serif;
    background-color: #e8f5e9;
}
.tela {
    width: 90%;
    max-width: 500px;
    margin: 100px auto;
    padding: 40px;
    background-color: white;
    border-radius: 20px;
    text-align: center;
}

h1 {
    color: #2efd32;
}

p {
    font-size: 78px;
}

button {
    display: block;
    width: 100%;
    margin: 15px;
    padding: 15px;
    border: none;
    border-radius: 10px;
    background-color: #439047;
    color: white;
    font-size: 10px;
    cursor: pointer;
}

button:hover {
    background-color: #2ef632;
}

.escondida {
    display: none;
}